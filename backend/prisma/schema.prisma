datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("CASHIER") // ADMIN, PHARMACIST, CASHIER
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sales          Sale[]
  purchases      Purchase[]
  returns        Return[]
  stockMovements StockMovement[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  medicines   Medicine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String
  address       String?
  taxId         String?    // GSTIN or Drug License
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
  batches       Batch[]
}

model Medicine {
  id             String          @id @default(cuid())
  name           String
  genericName    String
  sku            String          @unique
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  dosageForm     String          // Tablet, Capsule, Syrup, Injection, Ointment, Drops
  strength       String          // e.g. 500mg, 650mg, 100ml
  manufacturer   String
  reorderLevel   Int             @default(20)
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  batches        Batch[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  returnItems    ReturnItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([name])
}

model Batch {
  id              String          @id @default(cuid())
  batchNumber     String
  medicineId      String
  medicine        Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  quantity        Int             @default(0) // Active remaining quantity (MUST BE >= 0)
  initialQuantity Int             @default(0)
  purchasePrice   Float
  sellingPrice    Float           // MRP
  mfgDate         DateTime
  expiryDate      DateTime        // Used for FEFO ordering
  status          String          @default("ACTIVE") // ACTIVE, EXPIRED, DEPLETED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  returnItems     ReturnItem[]
  stockMovements  StockMovement[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model Purchase {
  id            String          @id @default(cuid())
  invoiceNumber String          @unique
  supplierId    String
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  receivedDate  DateTime        @default(now())
  totalAmount   Float
  notes         String?
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         PurchaseItem[]
}

model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId   String
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  quantity     Int
  unitCost     Float
  sellingPrice Float
  mfgDate      DateTime
  expiryDate   DateTime
  totalCost    Float

  @@index([purchaseId])
  @@index([medicineId])
  @@index([batchId])
}

model Sale {
  id             String       @id @default(cuid())
  invoiceNumber  String       @unique
  customerName   String       @default("Walk-in Customer")
  customerPhone  String?
  doctorName     String?
  paymentMethod  String       @default("CASH") // CASH, CARD, UPI
  subtotal       Float
  taxPercent     Float        @default(0)
  taxAmount      Float        @default(0)
  discount       Float        @default(0)
  totalAmount    Float
  amountPaid     Float
  changeReturned Float        @default(0)
  status         String       @default("COMPLETED") // COMPLETED, PARTIALLY_RETURNED, FULLY_RETURNED
  cashierId      String
  cashier        User         @relation(fields: [cashierId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          SaleItem[]
  returns        Return[]

  @@index([invoiceNumber])
  @@index([createdAt])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id])
  quantity   Int
  unitPrice  Float
  lineTotal  Float

  @@index([saleId])
  @@index([medicineId])
  @@index([batchId])
}

model Return {
  id           String          @id @default(cuid())
  returnNumber String          @unique
  saleId       String?
  sale         Sale?           @relation(fields: [saleId], references: [id])
  type         String          // CUSTOMER_RETURN, EXPIRED_DISPOSAL, DAMAGE_BREAKAGE, AUDIT_ADJUSTMENT
  reason       String          // Mandatory business audit reason
  refundAmount Float           @default(0)
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        ReturnItem[]

  @@index([returnNumber])
  @@index([saleId])
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnId        String
  return          Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine @relation(fields: [medicineId], references: [id])
  batchId         String
  batch           Batch    @relation(fields: [batchId], references: [id])
  quantity        Int
  refundUnitPrice Float    @default(0)

  @@index([returnId])
  @@index([medicineId])
  @@index([batchId])
}

model StockMovement {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  movementType  String   // PURCHASE, SALE, CUSTOMER_RETURN, DAMAGE_BREAKAGE, EXPIRED_DISPOSAL, AUDIT_ADJUSTMENT_ADD, AUDIT_ADJUSTMENT_SUB
  medicineId    String
  medicine      Medicine @relation(fields: [medicineId], references: [id])
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id])
  quantityDelta Int      // Positive = stock in, Negative = stock out
  balanceAfter  Int      // Snapshot of batch quantity after the movement
  reason        String?
  referenceId   String?  // Links to SaleId, PurchaseId, ReturnId
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])

  @@index([medicineId])
  @@index([batchId])
  @@index([timestamp])
  @@index([movementType])
}
